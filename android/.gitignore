# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/
app/build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/
workspace.xml
tasks.xml

# Keystore files
#
# IMPORTANTE: En este proyecto de ejemplo la keystore de RELEASE y
# key.properties SI se incluyen en el repositorio para que GitHub Actions
# pueda firmar y generar un APK instalable sin configurar secretos.
# Para produccion real, comenta/activa las lineas siguientes y usa Secretos.
#
# *.jks
# *.keystore
# key.properties

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (optional secrets)
# google-services.json

# Mac
.DS_Store

# Android/Google
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
