<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_slot.xml
  FIX: se añade el estado disabled/focused y un borde de selección más
  contrastado. El selector anterior sólo contemplaba state_selected, por lo que
  un slot táctil no mostraba feedback ni distinguía "no disponible".
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="120">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_variant" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/divider"
                android:dashWidth="6dp" android:dashGap="4dp" />
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/secondary" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/secondary" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/divider" />
        </shape>
    </item>
</selector>
