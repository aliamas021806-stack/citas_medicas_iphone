<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_chip.xml
  FIX: se añade un estado selected para las especialidades (chip activo).
  El selector original era un <shape> plano, sin estado, por lo que el chip
  seleccionado nunca se distinguía visualmente (parecía que el clic no funcionaba).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="120">

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/primary_dark" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/background" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/divider" />
        </shape>
    </item>
</selector>
