# =============================================================================
# .gitattributes  --  CRITICO para que el build funcione en GitHub Actions
# =============================================================================
# Sin este archivo, Git puede:
#   1) Corromper el binario gradle/wrapper/gradle-wrapper.jar al "normalizar" EOL
#   2) Convertir gradlew a formato CRLF, rompiendo los shebang #!/bin/sh
#   3) Alterar otros binarios (PNG, JKS, APK...) generando fallos de build/install
# =============================================================================

# Normalizacion global: en el repositorio SIEMPRE LF
* text=auto eol=lf

# --- Binarios: JAMAS tocar (evita la "incompatibilidad de archivo") ----------
*.jar   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.apk   binary
*.aab   binary
*.ap_    binary
*.dex   binary
*.class binary
*.jks   binary
*.keystore binary
*.zip   binary
*.gz    binary
*.tar   binary

# El JAR del wrapper Gradle DEBE permanecer intacto byte a byte
gradle/wrapper/gradle-wrapper.jar binary

# --- Scripts ----------------------------------------------------------------
*.sh              text eol=lf
gradlew           text eol=lf
*.bat             text eol=crlf
*.cmd             text eol=crlf
gradlew.bat       text eol=crlf

# --- Codigo y configuracion --------------------------------------------------
*.java text eol=lf
*.kt   text eol=lf
*.kts  text eol=lf
*.gradle text eol=lf
*.pro  text eol=lf
*.xml  text eol=lf
*.properties text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.json text eol=lf

# --- Reconocimiento de lenguaje en GitHub -----------------------------------
*.gradle linguist-language=Groovy
gradlew  linguist-language=Shell

# --- Archivos generados: marcar como binarios para evitar diffs --------------
*.apk -diff
*.aab -diff
